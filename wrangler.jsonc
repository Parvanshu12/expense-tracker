{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spendwise",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spendwise-db",
      "database_id": "58287c27-252d-4e48-b86f-468a7adcfabf",
      "migrations_dir": "migrations"
    }
  ],
  // Uploaded bank statements, read by the spendwise-ai worker's import Workflow.
  "r2_buckets": [{ "binding": "STATEMENTS", "bucket_name": "spendwise-statements" }],
  // Sign-in attempts per IP (approximate, per Cloudflare location).
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "4730",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "CF_AI_WORKER_URL": "https://spendwise-ai.dishis.workers.dev"
  }
  // Secret: CF_AI_WORKER_SECRET (same value as API_SECRET on the spendwise-ai worker).
  // Set it with: npx wrangler secret put CF_AI_WORKER_SECRET
}
