# SpendWise AI — Environment Configuration
# Copy this file to .env.local and populate the values below.

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Publicly exposed in browser code (safe for client-side queries with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret key for server-side trusted administrative operations ONLY.
# NEVER expose this key in client-side code, public GitHub repos, or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# OPENAI / AI CONFIGURATION
# -----------------------------------------------------------------------------
# Secret key used strictly on server-side Next.js API routes for natural-language
# expense extraction, categorization, and financial spending insights.
# NEVER expose this key on the client.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
