{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spendwise-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // Per-client limit (keyed by user id or IP, forwarded by the Next.js server).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4729",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    // Coach (quality matters more than speed).
    "TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Expense extraction (speed matters: it sits between typing and saving).
    "EXTRACT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "SPEECH_MODEL": "@cf/openai/whisper-large-v3-turbo"
  }
  // Secret: API_SECRET (shared with the Next.js server as CF_AI_WORKER_SECRET).
  // Set it with: npx wrangler secret put API_SECRET
}
