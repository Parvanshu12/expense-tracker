{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spendwise-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // Background statement imports read the uploaded file from R2 and write to the app's D1.
  "d1_databases": [
    { "binding": "DB", "database_name": "spendwise-db", "database_id": "58287c27-252d-4e48-b86f-468a7adcfabf" }
  ],
  "r2_buckets": [{ "binding": "STATEMENTS", "bucket_name": "spendwise-statements" }],
  "workflows": [
    { "name": "spendwise-statement-import", "binding": "STATEMENT_IMPORT", "class_name": "StatementImportWorkflow" }
  ],
  // Per-client limit (keyed by user id or IP, forwarded by the Next.js server).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4729",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    // Coach (quality matters more than speed).
    "TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Expense extraction (speed matters: it sits between typing and saving).
    "EXTRACT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Chat entry (several items per message, follow-up questions).
    "ENTRY_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "SPEECH_MODEL": "@cf/openai/whisper-large-v3-turbo"
  }
  // Secret: API_SECRET (shared with the Next.js server as CF_AI_WORKER_SECRET).
  // Set it with: npx wrangler secret put API_SECRET
}
